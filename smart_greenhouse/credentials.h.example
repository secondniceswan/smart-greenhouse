#ifndef CREDENTIALS_H
#define CREDENTIALS_H

// =============================================================================
// Smart Greenhouse IoT — Kredensial WiFi & Supabase
// =============================================================================
//
// CARA PAKAI:
//   1. Copy file ini menjadi "credentials.h" (hilangkan .example)
//   2. Isi WIFI_SSID dan WIFI_PASSWORD dengan WiFi Anda
//   3. Isi SUPABASE_URL dan SUPABASE_KEY dari dashboard Supabase
//   4. JANGAN commit credentials.h ke git (sudah ada di .gitignore)
//

// ======================== WiFi ========================
#define WIFI_SSID         "nama_wifi_anda"
#define WIFI_PASSWORD     "password_wifi_anda"

// ======================== Supabase ========================
// Dapatkan dari: Supabase Dashboard → Settings → API
//   - Project URL: https://xxxxx.supabase.co
//   - Anon Key:    eyJhbGciOiJ... (yang "anon public", BUKAN "service_role")
#define SUPABASE_URL      "https://xxxxx.supabase.co"
#define SUPABASE_KEY      "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

#endif
